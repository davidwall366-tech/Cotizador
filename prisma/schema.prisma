// Prisma schema — Cotizador de Embarque, Naviera GV
// Postgres (Neon). See .env for DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLEADO
}

model User {
  id           String   @id @default(cuid())
  // Login credential — auto-generated from the employee's email on creation
  // (see employees.ts); no longer entered by hand in the admin UI.
  username     String   @unique
  passwordHash String
  nombre       String
  // Required going forward for new/edited accounts (see employee-schema.ts) —
  // still nullable here so pre-existing accounts aren't broken retroactively.
  email        String?  @unique
  role         Role     @default(EMPLEADO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes Quote[] @relation("QuoteCreatedBy")
}

enum Direccion {
  ida
  vuelta
}

enum Estado {
  pendiente
  aprobada
  rechazada
}

enum TipoItem {
  vehiculo
  carga_general
  cajon266
  cajon173
  cajon231
  contenedor10
}

// A single formal quote. `lineas`/`total`/`abono` are a computed snapshot
// taken at save time (see lib/pricing.ts) so historical documents stay
// stable even if pricing logic changes later.
model Quote {
  id     String @id @default(cuid())
  numero Int    @unique

  direccion        Direccion @default(ida)
  cliente          String
  clienteRut       String    @default("")
  // Whether clienteRut/clienteDireccion/clienteTelefono should each be
  // printed on the formal document — independently toggled per quote.
  mostrarRut       Boolean   @default(false)
  clienteDireccion String    @default("")
  mostrarDireccion Boolean   @default(false)
  clienteTelefono  String    @default("")
  mostrarTelefono  Boolean   @default(false)
  correo           String
  fecha            DateTime
  vigenciaDias     Int       @default(7)
  vendedor         String    @default("")
  viajeN           String    @default("")
  zarpe            String    @default("")
  plazoRecepcion   String    @default("")
  notas            String    @default("")

  estado Estado @default(pendiente)

  // Set once the day-7 "about to expire" reminder email has gone out, so the
  // daily cron doesn't re-send it. Cleared whenever the quote is edited (the
  // expiration date may have moved) or reopened back to pendiente.
  alertaVencimientoEnviada Boolean @default(false)

  // Computed snapshot (JSON: { label, value }[]) + totals, in CLP.
  lineasJson String @default("[]")
  total      Int    @default(0)
  abono      Int    @default(0)

  createdById String?
  createdBy   User?   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]

  @@index([estado])
  @@index([direccion])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order   Int    @default(0)

  tipo TipoItem

  // carga_general
  cargaM3       Float?
  cargaDesc     String @default("")
  embalajeCosto Float?

  // cajon266 / cajon173 / cajon231 / contenedor10
  cajonCantidad Int    @default(1)
  cajonDesc     String @default("")

  vehiculos Vehiculo[]

  @@index([quoteId])
}

// Only populated when QuoteItem.tipo == vehiculo (one row per vehicle).
model Vehiculo {
  id          String    @id @default(cuid())
  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  largo       Float
  ancho       Float
  alto        Float

  @@index([quoteItemId])
}

// Singleton row (id "default") holding every configurable price used by the
// pricing engine (see lib/tarifas.ts, lib/pricing.ts). Admin-editable via
// /tarifas. Existing quotes are unaffected when these change — their
// lineas/total/abono are a frozen snapshot (see Quote model comment above).
model Tarifa {
  id String @id @default("default")

  // Transporte marítimo, $ por m³.
  maritimoIdaVehiculo Int @default(255800)
  maritimoIdaOtros    Int @default(240800)
  maritimoVuelta      Int @default(132800)

  // Vehículos: grúa de traslado, $ por vehículo.
  gruaVehiculo Int @default(95000)

  // Cajones: fabricación (por cajón, distinto por tamaño) + accesorios (por
  // cajón, iguales para los tres tamaños). Zunchos/Tapas/Nylon parten en 0 —
  // no aparecen en la cotización hasta que un administrador les asigne valor.
  fabricacionCajon266 Int @default(84000)
  fabricacionCajon173 Int @default(66000)
  fabricacionCajon231 Int @default(84000)
  fundaProteccion     Int @default(21000)
  zunchos             Int @default(0)
  tapas               Int @default(0)
  nylon               Int @default(0)

  // Cajones y contenedor: consolidación, $ por m³.
  consolidacionPorM3 Int @default(11000)

  // Contenedor 10 pies: arriendo, $ por contenedor.
  arriendoContenedor10 Int @default(45000)

  // Seguro de carga, $ por m³, aplicado al volumen de cada ítem. Parte en 0
  // — no aparece en la cotización hasta que un administrador le asigne valor.
  seguroCargaPorM3 Int @default(0)

  updatedAt DateTime @updatedAt
}
