# next-auth@5 beta lists nodemailer ^7||^8 as an optional peer (for its Email
# provider, which we don't use — we use Credentials only). We're pinned to
# nodemailer@9 for a security fix (GHSA-p6gq-j5cr-w38f), which Vercel's build
# otherwise fails on as a hard ERESOLVE error.
legacy-peer-deps=true
